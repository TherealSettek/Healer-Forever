<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\..\WoW\Data\Interface\AddOns\Blizzard_SharedXML\UI.xsd">

	<ScopedModifier useForbiddenObjectTable="true">
		<!-- Mouse defaults apply at creation (no protected call): the game also creates these buttons in combat, before
		     Auras.lua may change the mouse setup. Clicks off so a click always reaches the unit button underneath;
		     motion on for the aura tooltip. -->
		<AuraButton name="HealerForeverAuraButtonTemplate" inherits="CustomAuraButtonTemplate" virtual="true" enableMouseClicks="false" enableMouseMotion="true">
			<Size x="16" y="16"/>
			<Layers>
				<Layer level="BACKGROUND">
					<Texture parentKey="Backdrop" file="Interface\Buttons\WHITE8X8" setAllPoints="true">
						<Color r="0" g="0" b="0" a="1"/>
					</Texture>
				</Layer>
				<Layer level="ARTWORK">
					<Texture parentKey="Icon">
						<Anchors>
							<Anchor point="TOPLEFT" x="1" y="-1"/>
							<Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
						</Anchors>
						<TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92"/>
					</Texture>
				</Layer>
				<Layer level="OVERLAY" textureSubLevel="1">
					<Texture parentKey="DispelBorder" setAllPoints="true"/>
				</Layer>
				<Layer level="OVERLAY" textureSubLevel="3">
					<FontString parentKey="Count" inherits="NumberFontNormalSmall">
						<Anchors>
							<Anchor point="TOPRIGHT" x="1" y="0"/>
						</Anchors>
					</FontString>
					<FontString parentKey="Time" inherits="NumberFontNormalSmall">
						<Anchors>
							<Anchor point="TOP" relativePoint="BOTTOM" x="0" y="-1"/>
						</Anchors>
					</FontString>
				</Layer>
			</Layers>
			<Frames>
				<Cooldown parentKey="Cooldown" inherits="CooldownFrameTemplate" reverse="true" drawEdge="false" hideCountdownNumbers="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="1" y="-1"/>
						<Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
					</Anchors>
				</Cooldown>
			</Frames>
		</AuraButton>

		<!-- Raid debuff icons (Frames/RaidFrames.lua): same parts as above, but no mouse at all from creation on. The
		     game creates them lazily, also mid-fight, when the mouse setters are blocked; the raid bar underneath keeps
		     hover and clicks. The party template above is unchanged. -->
		<AuraButton name="HealerForeverRaidAuraButtonTemplate" inherits="HealerForeverAuraButtonTemplate" virtual="true" enableMouseClicks="false" enableMouseMotion="false"/>

		<!-- Raid bar glow carrier: one per raid bar (its own container, max 1 button). No visible parts of its own: the
		     game shows / hides it with the first dispellable debuff and tints the glow texture the addon hands it
		     (AddDispelTypeTexture, inside a plain holder frame). No mouse. -->
		<AuraButton name="HealerForeverRaidGlowButtonTemplate" inherits="CustomAuraButtonTemplate" virtual="true" enableMouseClicks="false" enableMouseMotion="false">
			<Size x="1" y="1"/>
		</AuraButton>
	</ScopedModifier>
</Ui>
